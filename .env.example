# Скопируй в .env (для Docker) и заполни. Для npm run dev — в .env.local (+ DATABASE_URL).

# Публичный адрес сайта
SITE_URL=https://mok-cherkessk.ru

# Внешний порт контейнера с сайтом (docker compose)
PORT=3000

# Пароль PostgreSQL. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# Первый администратор: создаётся при первом запуске, если в базе ещё нет ни одного.
# Пароль — от 12 символов, буквы и цифры. После первого входа строки можно удалить.
# Сменить пароль позже: docker compose exec web ... или npm run admin:create -- <логин>
ADMIN_LOGIN=
ADMIN_PASSWORD=

# debug | info | warn | error
LOG_LEVEL=info

# Секрет для POST /api/revalidate. Сгенерировать: openssl rand -hex 32. Пусто — эндпоинт выключен.
REVALIDATE_SECRET=

# Только для разработки (npm run dev), в Docker задаётся автоматически:
# DATABASE_URL=postgres://mok:<POSTGRES_PASSWORD>@127.0.0.1:5432/mok
