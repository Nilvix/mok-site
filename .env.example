# Скопируй в .env (для Docker) или .env.local (для npm run dev) и заполни.

# Публичный адрес сайта
SITE_URL=https://mok-cherkessk.ru

# Внешний порт контейнера (docker compose)
PORT=3000

# debug | info | warn | error
LOG_LEVEL=info

# Секрет для POST /api/revalidate — обновить отзывы и фото с Яндекса без ожидания кэша.
# Сгенерировать: openssl rand -hex 32. Пусто — эндпоинт выключен.
REVALIDATE_SECRET=

# Зарезервировано под Apify (сейчас не используется)
APIFY_TOKEN=
