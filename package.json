{
  "name": "mok-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync:yandex": "node scripts/sync-yandex.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "docker:build": "docker build -t mok-site .",
    "docker:up": "docker compose up -d --build",
    "build:pages": "GITHUB_PAGES=true next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "apify-client": "^2.25.0",
    "drizzle-orm": "^0.36.4",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.408.0",
    "next": "14.2.5",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
